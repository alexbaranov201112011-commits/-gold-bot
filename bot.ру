import os, requests
from datetime import datetime

BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")

def send(text):
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
    r = requests.post(url, json={"chat_id": CHAT_ID, "text": text, "parse_mode": "HTML"}, timeout=10)
    print(r.text)

try:
    data = requests.get("https://api.gold-api.com/price/XAU", timeout=10).json()
    price = float(data.get("price", 4418))
except:
    price = 4418.20

signal = "🔴 SELL ШОРТ" if price < 4423 else "🟢 BUY ЛОНГ"
now = datetime.now().strftime("%H:%M")

msg = f"🏆 <b>GOLD ${price:.2f}</b>\n{signal}\n⏰ {now} Aktau | 24/7 ✅\n\n#49 FIXED"
send(msg)
